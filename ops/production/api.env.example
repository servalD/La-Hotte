# Variables de l'API en production (apps/api/src/platform/config/env.ts, OBS-46). Copier en
# `api.env`, droits 600, jamais versionné (SEC-21). NODE_ENV, PORT, TRUSTED_PROXY_HOPS,
# IMAGE_STORAGE_DIR, FETCHER_URL, DEPLOY_ENVIRONMENT et OTEL_EXPORTER_OTLP_ENDPOINT viennent de
# compose.yaml. Chaque secret se tire au hasard : `openssl rand -base64 48`.
DATABASE_URL=postgresql://wishlist_app:<APP_DB_PASSWORD>@postgres:5432/wishlist
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
WEB_ORIGIN=https://lahotte.example
# AUTH-09 : valeur initiale ; un administrateur la change à chaud (ADM-09).
REGISTRATION_MODE=OPEN
# Deux secrets distincts (le démarrage refuse qu'ils soient égaux).
CSRF_SECRET=
KEY_HMAC_SECRET=
CACHE_KEY_SECRET=
# SEC-22 : trousseau `id:clé` (32 octets en base64) ; l'identifiant 0 est refusé en production.
SECRET_ENCRYPTION_KEYS=
# Même valeur que FETCHER_TOKEN de `.env`.
FETCHER_TOKEN=
SMTP_URL=
MAIL_FROM=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:exploitation@lahotte.example
SENTRY_DSN=
TRACES_SAMPLE_RATIO=0.1
LOG_LEVEL=info
