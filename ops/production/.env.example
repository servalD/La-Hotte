# Production (ops/production/README.md). Copier en `.env`, droits 600, jamais versionné (SEC-21).
# Chaque secret se tire au hasard : `openssl rand -base64 48`.

# Noms d'hôte (DEP-07) : l'application seule sur le sien ; l'exploitation sur les siens.
APP_HOST=lahotte.example
GLITCHTIP_HOST=erreurs.ops.lahotte.example
OBSERVE_HOST=mesures.ops.lahotte.example
ACME_EMAIL=exploitation@lahotte.example
# OBS-27 : adresses autorisées sur les hôtes d'exploitation (VPN, poste d'exploitation, CI pour
# l'envoi des cartes de source), séparées par des espaces.
OPS_ALLOWED_IPS=203.0.113.10/32

# Images (DEP-04) : empreintes publiées par la CI après l'analyse Trivy (CI-05).
API_IMAGE=registry.example/lahotte-api@sha256:...
API_MIGRATE_IMAGE=registry.example/lahotte-api-migrate@sha256:...
WEB_IMAGE=registry.example/lahotte-web@sha256:...
FETCHER_IMAGE=registry.example/lahotte-fetcher@sha256:...
RELEASE=

# Base (DAT-03) : propriétaire pour les migrations, rôle applicatif pour l'API.
POSTGRES_OWNER_PASSWORD=
APP_DB_PASSWORD=
DATABASE_MIGRATION_URL=postgresql://wishlist:<POSTGRES_OWNER_PASSWORD>@postgres:5432/wishlist
REDIS_PASSWORD=
FETCHER_TOKEN=

# Observabilité (ADR 0012).
WEB_SENTRY_DSN=
OPENOBSERVE_ROOT_EMAIL=exploitation@lahotte.example
OPENOBSERVE_ROOT_PASSWORD=
# "Basic " + base64("<email>:<mot de passe>") d'un utilisateur d'ingestion d'OpenObserve.
OPENOBSERVE_AUTHORIZATION=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# OBS-43 : alertes par SMTP, hors de l'application.
ALERT_FROM_EMAIL=alertes@lahotte.example
ALERT_SMTP_URL=smtp+tls://utilisateur:motdepasse@smtp.example:587

# DEP-05 : sauvegardes (scripts/backup.sh).
BACKUP_DIR=/var/backups/lahotte
# Clé publique `age` du coffre hors ligne ; la clé privée n'est jamais sur le serveur.
BACKUP_AGE_RECIPIENT=age1...
# Copie hors du serveur, dans l'Union européenne (RGPD-01) : commande qui reçoit le dossier.
BACKUP_OFFSITE_CMD=rclone copy --immutable "$BACKUP_DIR" offsite:lahotte
BACKUP_RETENTION_DAYS=30
