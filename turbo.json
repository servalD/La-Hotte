{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BROWSER_SOURCEMAPS"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "SHADOW_DATABASE_URL",
        "REDIS_URL",
        "WEB_ORIGIN",
        "LOG_LEVEL",
        "CSRF_SECRET",
        "KEY_HMAC_SECRET",
        "TRUSTED_PROXY_HOPS",
        "REGISTRATION_MODE",
        "SMTP_URL",
        "MAIL_FROM"
      ]
    },
    "test:leak": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "WEB_ORIGIN",
        "LOG_LEVEL",
        "CSRF_SECRET",
        "KEY_HMAC_SECRET",
        "TRUSTED_PROXY_HOPS",
        "REGISTRATION_MODE",
        "SMTP_URL",
        "MAIL_FROM"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
