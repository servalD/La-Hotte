{
  "name": "@wishlist/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --enable-source-maps --import ./dist/instrument.js\"",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:leak": "nest build && vitest run --config vitest.leak.config.ts",
    "openapi": "nest build && node dist/openapi/emit-openapi.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.72.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prisma/client": "^6.19.0",
    "@prisma/instrumentation": "6.19.3",
    "@sentry/nestjs": "11.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "10.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "8.0.0",
    "@types/supertest": "^6.0.3",
    "@wishlist/config": "workspace:*",
    "eslint": "^9.39.1",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.8",
    "vitest": "^3.2.4"
  }
}
