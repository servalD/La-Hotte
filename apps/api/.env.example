# Développement local uniquement (docker compose). Copier en .env, ne jamais versionner .env.
NODE_ENV=development
# Documentation interactive sur /api/docs (développement seulement).
ENABLE_API_DOCS=true
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Rôle applicatif : lecture et écriture, aucun droit sur le schéma (DAT-03).
DATABASE_URL=postgresql://wishlist_app:wishlist_app@localhost:5432/wishlist
# Rôle de migration, utilisé par la CLI Prisma uniquement.
DATABASE_MIGRATION_URL=postgresql://wishlist:wishlist@localhost:5432/wishlist
# Base fantôme de prisma migrate dev / migrate diff.
SHADOW_DATABASE_URL=postgresql://wishlist:wishlist@localhost:5432/wishlist_shadow

REDIS_URL=redis://localhost:6379

# Session (ADR 0013). Valeurs de développement seulement ; en production, 32 octets aléatoires
# chacun (`openssl rand -base64 32`), distincts.
CSRF_SECRET=dev-only-csrf-secret-0123456789abcdef
KEY_HMAC_SECRET=dev-only-key-hmac-secret-0123456789abcdef
# Chiffrement des secrets TOTP (SEC-22, AUTH-11) : `id:clé` (32 octets en base64), la première
# chiffre, toutes déchiffrent. L'identifiant 0 est refusé en production : y mettre par exemple
# `1:` suivi de `openssl rand -base64 32` ; pour une rotation, ajouter la nouvelle clé en tête.
SECRET_ENCRYPTION_KEYS=0:ZGV2LW9ubHktc2VjcmV0LWVuY3J5cHRpb24ta2V5LTA=
# Mandataires de confiance devant l'API : 0 en local, 1 en production (Caddy).
TRUSTED_PROXY_HOPS=0
# AUTH-09 : OPEN ou INVITE_ONLY.
REGISTRATION_MODE=OPEN
# E-mails : Mailpit local (interface http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@lahotte.localhost
# Connexion avec Google (AUTH-03), facultative : les deux ou aucun. Client OAuth « Application
# Web » de la console Google, URI de redirection autorisée : <WEB_ORIGIN>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Télémétrie (OBS-46), désactivée si vide (OBS-14). Pile locale : docker compose --profile obs up -d
# DSN : créer un projet dans GlitchTip (http://localhost:8000).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEPLOY_ENVIRONMENT=development
