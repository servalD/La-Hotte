// Traduction de docs/spec/12-modele-de-donnees.md. La spec reste la référence.
// Conventions : UUID v7 fournis par l'application, snake_case en base, created_at / updated_at partout,
// version sur les entités modifiables hors ligne, énumérations en types de base.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // La CLI (migrations) utilise le rôle propriétaire du schéma ; l'application se connecte
  // avec DATABASE_URL (rôle sans droit sur le schéma, DAT-03), passé à PrismaClient.
  url               = env("DATABASE_MIGRATION_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Module type de la phase 0, dont le code (API et web) est retiré. DAT-07 : la table reste jusqu'au
// déploiement suivant ; une migration à part la supprimera, avec ces deux déclarations.
enum ExamplePriority {
  LOW
  NORMAL
  HIGH

  @@map("example_priority")
}

model ExampleItem {
  id             String          @id @db.Uuid
  title          String          @db.VarChar(120)
  priority       ExamplePriority @default(NORMAL)
  reservedByName String?         @map("reserved_by_name") @db.VarChar(80)
  reservedAt     DateTime?       @map("reserved_at") @db.Timestamptz(3)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("example_item")
}

// --- Identité (docs/spec/12, « Identité » ; ADR 0013) ---

enum AccountRole {
  USER
  MODERATOR
  ADMIN

  @@map("account_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

enum AccountTokenPurpose {
  EMAIL_VERIFY
  EMAIL_CHANGE
  EMAIL_CHANGE_CANCEL
  PASSWORD_RESET
  /// PRO-10 : vérification de l'adresse d'un profil.
  PROFILE_EMAIL_VERIFY
  /// PRO-12 : accord du profil à un passage, par son adresse.
  TRANSFER_CONSENT
  /// PRO-12 : annulation d'un passage par le profil, pendant le délai d'exécution.
  TRANSFER_CANCEL

  @@map("account_token_purpose")
}

enum PinRelock {
  NEVER
  IDLE_15
  EVERY_OPEN

  @@map("pin_relock")
}

enum LinkStatus {
  PENDING
  AWAITING_GUARDIAN
  ACCEPTED

  @@map("link_status")
}

enum InvitationKind {
  LINK
  /// PRO-11 : invitation à créer un profil.
  PROFILE
  LIST
  EVENT

  @@map("invitation_kind")
}

/// LNK-11, PRO-15 : d'où vient un lien. `GUARDIANSHIP` seul fonde la tutelle d'un compte sous tutelle.
enum LinkOrigin {
  INVITATION
  TRANSFER
  GUARDIANSHIP

  @@map("link_origin")
}

/// PRO-12, PRO-13, PRO-15.
enum TransferKind {
  MOVE
  DETACH
  WARD

  @@map("transfer_kind")
}

/// PRO-12 : PIN du profil dans le compte d'arrivée.
enum TransferPinChoice {
  KEEP
  NEW
  NONE

  @@map("transfer_pin_choice")
}

/// E-mail stocké normalisé (minuscules, CHECK en base) : l'unicité est donc insensible à la casse.
model Account {
  id                         String        @id @db.Uuid
  email                      String        @unique @db.VarChar(254)
  emailVerifiedAt            DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordHash               String?       @map("password_hash") @db.VarChar(255)
  role                       AccountRole   @default(USER)
  status                     AccountStatus @default(ACTIVE)
  totpSecretEnc              Bytes?        @map("totp_secret_enc")
  totpEnabledAt              DateTime?     @map("totp_enabled_at") @db.Timestamptz(3)
  /// AUTH-11 : dernier pas de temps TOTP accepté ; un code de ce pas ou d'un pas antérieur est refusé.
  totpLastStep               Int?          @map("totp_last_step")
  /// AUTH-08 : absent seulement pour un compte sous tutelle (`CHECK`), dont le tuteur a déclaré l'autorité.
  ageAttestedAt              DateTime?     @map("age_attested_at") @db.Timestamptz(3)
  /// PRO-15 : compte tuteur ; jamais lui-même sous tutelle, et tous les profils sont enfants (déclencheurs).
  guardianAccountId          String?       @map("guardian_account_id") @db.Uuid
  /// RGPD-06 : déclaration d'autorité parentale du tuteur.
  guardianAttestedAt         DateTime?     @map("guardian_attested_at") @db.Timestamptz(3)
  /// PRO-16 : levée demandée par le tuteur, effective à la déclaration d'âge.
  guardianReleaseRequestedAt DateTime?     @map("guardian_release_requested_at") @db.Timestamptz(3)
  /// AUTH-09, LNK-08 : invitation à consommer à la vérification de l'e-mail.
  pendingInvitationId        String?       @map("pending_invitation_id") @db.Uuid
  authEpoch                  Int           @default(0) @map("auth_epoch")
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities        AuthIdentity[]
  recoveryCodes     RecoveryCode[]
  tokens            AccountToken[]
  sessions          Session[]
  trustedDevices    TrustedDevice[]
  profiles          Profile[]
  pendingInvitation Invitation?       @relation("PendingInvitation", fields: [pendingInvitationId], references: [id], onDelete: SetNull)
  guardian          Account?          @relation("Guardianship", fields: [guardianAccountId], references: [id], onDelete: Restrict)
  wards             Account[]         @relation("Guardianship")
  transfersFrom     ProfileTransfer[] @relation("TransferFrom")
  transfersTo       ProfileTransfer[] @relation("TransferTo")

  @@index([pendingInvitationId])
  @@index([guardianAccountId])
  @@map("account")
}

model AuthIdentity {
  id        String       @id @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  provider  AuthProvider
  subject   String       @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  /// AUTH-03 : une seule identité Google par compte.
  @@unique([accountId, provider])
  @@index([accountId])
  @@map("auth_identity")
}

/// Codes de secours (AUTH-10, SEC-22) : 80 bits tirés par le serveur, stockés en SHA-256.
model RecoveryCode {
  id        String    @id @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  /// SHA-256 du code normalisé, en hexadécimal.
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, codeHash])
  @@map("recovery_code")
}

model AccountToken {
  id         String              @id @db.Uuid
  accountId  String              @map("account_id") @db.Uuid
  purpose    AccountTokenPurpose
  /// SHA-256 du jeton, en hexadécimal (64 caractères).
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  newEmail   String?             @map("new_email") @db.VarChar(254)
  /// PRO-10, PRO-12 : profil visé (`PROFILE_EMAIL_VERIFY`, `TRANSFER_CONSENT`, `TRANSFER_CANCEL`).
  profileId  String?             @map("profile_id") @db.Uuid
  /// PRO-12 : demande visée (`TRANSFER_CONSENT`, `TRANSFER_CANCEL`).
  transferId String?             @map("transfer_id") @db.Uuid
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  account  Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile  Profile?         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transfer ProfileTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
  @@index([profileId])
  @@index([transferId])
  @@map("account_token")
}

/// Une ligne ne disparaît que par la procédure de révocation (ADR 0013) : `account_id` en RESTRICT.
model Session {
  id                String    @id @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  /// SHA-256 du jeton, en hexadécimal. Ni le jeton ni ce hash ne sortent du serveur.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  authEpoch         Int       @map("auth_epoch")
  activeProfileId   String?   @map("active_profile_id") @db.Uuid
  reauthAt          DateTime? @map("reauth_at") @db.Timestamptz(3)
  trustedDeviceId   String?   @map("trusted_device_id") @db.Uuid
  userAgent         String    @map("user_agent") @db.VarChar(512)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// OFF-30 : appareil partagé (12 h au plus, 2 h sans activité, aucun appareil de confiance).
  sharedDevice      Boolean   @default(false) @map("shared_device")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  activeProfile Profile?           @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  trustedDevice TrustedDevice?     @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)
  pushDevices   PushSubscription[]

  @@index([accountId])
  @@map("session")
}

model TrustedDevice {
  id        String    @id @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userAgent String    @map("user_agent") @db.VarChar(512)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([accountId])
  @@map("trusted_device")
}

/// 10 profils au plus par compte : garanti par un déclencheur (migration), DAT-01.
model Profile {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  displayName           String    @map("display_name") @db.VarChar(60)
  /// Clé de l'image d'avatar ; sans image, couleur d'accent et initiales.
  avatar                String?   @db.VarChar(200)
  accentColor           String    @map("accent_color") @db.Char(7)
  birthdayDay           Int?      @map("birthday_day") @db.SmallInt
  birthdayMonth         Int?      @map("birthday_month") @db.SmallInt
  birthdayYear          Int?      @map("birthday_year") @db.SmallInt
  locale                String    @db.VarChar(16)
  currency              String    @db.Char(3)
  timezone              String    @db.VarChar(64)
  isChild               Boolean   @default(false) @map("is_child")
  /// PRO-09, PRO-12 : dernier changement du marqueur enfant ; moins de 30 jours, l'accord du profil reste requis.
  childChangedAt        DateTime? @map("child_changed_at") @db.Timestamptz(3)
  /// PRO-09 : notice du changement de marqueur, effacée par l'entrée qui la montre.
  childNoticeAt         DateTime? @map("child_notice_at") @db.Timestamptz(3)
  /// PRO-10 : adresse facultative, jamais identifiant de connexion ; absente pour un enfant (`CHECK`).
  email                 String?   @db.VarChar(254)
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(3)
  pinHash               String?   @map("pin_hash") @db.VarChar(255)
  pinRelock             PinRelock @default(IDLE_15) @map("pin_relock")
  pinFailedCount        Int       @default(0) @map("pin_failed_count")
  /// PIN-03 : PIN faux depuis la dernière entrée dans le profil ; seule la sélection l'efface.
  pinFailuresSinceEntry Int       @default(0) @map("pin_failures_since_entry")
  pinLockedUntil        DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  pinResetNoticeAt      DateTime? @map("pin_reset_notice_at") @db.Timestamptz(3)
  /// PIN-05, PRO-12 : dernière réinitialisation ou désactivation ; PIN-04 ne l'efface pas.
  pinResetAt            DateTime? @map("pin_reset_at") @db.Timestamptz(3)
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account         Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sessions        Session[]
  linksA          ProfileLink[]             @relation("LinkProfileA")
  linksB          ProfileLink[]             @relation("LinkProfileB")
  blocksMade      ProfileBlock[]            @relation("Blocker")
  blocksReceived  ProfileBlock[]            @relation("Blocked")
  invitations     Invitation[]              @relation("InvitationCreator")
  tokens          AccountToken[]
  transfers       ProfileTransfer[]
  products        Product[]
  createdLists    List[]                    @relation("ListCreator")
  personalList    List?                     @relation("PersonalList")
  listRoles       ListMember[]
  recipientOf     ListRecipient[]
  audienceOf      ListAudienceProfile[]
  itemsAdded      ListItem[]                @relation("ItemAddedBy")
  itemsIntended   ListItem[]                @relation("ItemIntendedFor")
  itemRules       ItemVisibilityProfile[]
  eventsCreated   Event[]                   @relation("EventCreator")
  eventRoles      EventParticipant[]        @relation("EventParticipantProfile")
  eventInvites    EventParticipant[]        @relation("EventParticipantInviter")
  surprisesFor    EventSurpriseRecipient[]
  comments        Comment[]                 @relation("CommentAuthor")
  reactions       CommentReaction[]
  follows         ItemFollow[]
  notifications   Notification[]            @relation("NotificationProfile")
  notified        Notification[]            @relation("NotificationActor")
  notifCounter    NotificationCounter?
  notifPrefs      NotificationPref[]
  notifSettings   NotificationSettings?
  pushDevices     PushSubscriptionProfile[]
  buyerOf         ItemAccounting[]          @relation("AccountingBuyer")
  contributions   Contribution[]            @relation("ContributionProfile")
  purchases       Purchase[]                @relation("PurchaseBuyer")
  reviewsAuthored AccountingReview[]        @relation("ReviewAuthor")
  reviewsDecided  AccountingReview[]        @relation("ReviewDecider")
  buyerRequests   BuyerRequest[]            @relation("BuyerCandidate")
  buyerDecisions  BuyerRequest[]            @relation("BuyerRequestDecider")
  shortfalls      ShortfallNotice[]         @relation("ShortfallAuthor")
  offsetsProposed OffsetProposal[]          @relation("OffsetProposer")
  offsetsReceived OffsetProposal[]          @relation("OffsetCounterpart")
  budgets         Budget[]                  @relation("BudgetOwner")
  budgetsFor      Budget[]                  @relation("BudgetRecipient")
  idempotency     IdempotencyRecord[]

  @@index([accountId])
  @@map("profile")
}

/// LNK-02 à LNK-06 : lien entre deux profils de comptes différents. Paire rangée `a < b`
/// (`CHECK`), comptes différents (déclencheur). `PENDING` est réservé à la phase 3.
model ProfileLink {
  id                  String     @id @db.Uuid
  profileAId          String     @map("profile_a_id") @db.Uuid
  profileBId          String     @map("profile_b_id") @db.Uuid
  status              LinkStatus
  /// L'invitant : l'un des deux profils (`CHECK`).
  requestedBy         String     @map("requested_by") @db.Uuid
  aGuardianRequired   Boolean    @map("a_guardian_required")
  bGuardianRequired   Boolean    @map("b_guardian_required")
  /// Profil non enfant qui a validé ; sans clé étrangère : un profil supprimé ne défait pas un lien.
  aGuardianApprovedBy String?    @map("a_guardian_approved_by") @db.Uuid
  bGuardianApprovedBy String?    @map("b_guardian_approved_by") @db.Uuid
  /// LNK-11 : `TRANSFER` et `GUARDIANSHIP` naissent acceptés, l'accord du compte valant validation.
  origin              LinkOrigin @default(INVITATION)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profileA Profile @relation("LinkProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB Profile @relation("LinkProfileB", fields: [profileBId], references: [id], onDelete: Cascade)

  @@unique([profileAId, profileBId])
  @@index([profileBId])
  @@map("profile_link")
}

/// LNK-05 : jamais exposé au profil bloqué.
model ProfileBlock {
  id        String   @id @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("profile_block")
}

/// LNK-01 : jeton de 128 bits, stocké en SHA-256. Pour `LINK`, `targetId` et `createdBy` sont le
/// profil invitant. `targetId` est polymorphe (liste, événement plus tard) : pas de clé étrangère.
model Invitation {
  id               String         @id @db.Uuid
  kind             InvitationKind
  targetId         String         @map("target_id") @db.Uuid
  tokenHash        String         @unique @map("token_hash") @db.Char(64)
  createdBy        String         @map("created_by") @db.Uuid
  maxUses          Int            @map("max_uses")
  usedCount        Int            @default(0) @map("used_count")
  /// PRO-11 (`PROFILE`) : marqueur enfant du profil à créer ; `targetId` est alors le compte visé.
  profileIsChild   Boolean?       @map("profile_is_child")
  /// PRO-11 : acceptation par le compte visé, posée à la création pour le compte de l'invitant.
  targetAcceptedAt DateTime?      @map("target_accepted_at") @db.Timestamptz(3)
  targetRefusedAt  DateTime?      @map("target_refused_at") @db.Timestamptz(3)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator Profile   @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  pending Account[] @relation("PendingInvitation")

  @@index([createdBy])
  @@index([expiresAt])
  @@map("invitation")
}

/// Ajout seul (DAT-02) : le rôle applicatif n'a ni UPDATE ni DELETE. Sans clé étrangère : le journal
/// survit à la suppression du compte, pour sa durée de conservation (SEC-33).
/// PRO-12, PRO-13, PRO-15 : demande de passage, de détachement ou de création d'un compte sous tutelle.
/// Une seule ouverte par profil (index unique partiel, migration).
model ProfileTransfer {
  id                     String            @id @db.Uuid
  kind                   TransferKind
  /// Absent seulement pour `WARD` avec un nouveau profil (`CHECK`).
  profileId              String?           @map("profile_id") @db.Uuid
  newProfileName         String?           @map("new_profile_name") @db.VarChar(60)
  fromAccountId          String            @map("from_account_id") @db.Uuid
  toAccountId            String?           @map("to_account_id") @db.Uuid
  newEmail               String?           @map("new_email") @db.VarChar(254)
  /// SHA-256 du jeton de passage (`MOVE`) ou du lien d'installation (`DETACH`, `WARD`).
  tokenHash              String            @unique @map("token_hash") @db.Char(64)
  /// Échéance du jeton : 7 jours pour un jeton de passage, 24 heures pour un lien d'installation, renvoyable.
  tokenExpiresAt         DateTime          @map("token_expires_at") @db.Timestamptz(3)
  /// PRO-12 : figé à la création.
  profileConsentRequired Boolean           @map("profile_consent_required")
  /// PRO-12 : regroupement déclaré par le compte d'origine.
  regroup                Boolean           @default(false)
  fromAcceptedAt         DateTime          @map("from_accepted_at") @db.Timestamptz(3)
  profileAcceptedAt      DateTime?         @map("profile_accepted_at") @db.Timestamptz(3)
  toAcceptedAt           DateTime?         @map("to_accepted_at") @db.Timestamptz(3)
  pinChoice              TransferPinChoice @map("pin_choice")
  newPinHash             String?           @map("new_pin_hash") @db.VarChar(255)
  /// PRO-12 : dernier accord + 48 heures ; une fois posé, `expiresAt` ne joue plus.
  executesAt             DateTime?         @map("executes_at") @db.Timestamptz(3)
  expiresAt              DateTime          @map("expires_at") @db.Timestamptz(3)
  completedAt            DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile     Profile?       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromAccount Account        @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account?       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  tokens      AccountToken[]

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([executesAt])
  @@map("profile_transfer")
}

model SecurityLog {
  id         String   @id @db.Uuid
  accountId  String?  @map("account_id") @db.Uuid
  /// PRO-14 : sans clé étrangère, comme `accountId`.
  profileId  String?  @map("profile_id") @db.Uuid
  transferId String?  @map("transfer_id") @db.Uuid
  event      String   @db.VarChar(64)
  ip         String   @db.Inet
  userAgent  String   @map("user_agent") @db.VarChar(512)
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId, at])
  @@map("security_log")
}

// --- Fiches article et listes (docs/spec/12, « Articles et listes » ; phase 2) ---

enum ProductSource {
  LINK
  PHOTO
  MANUAL

  @@map("product_source")
}

enum ShareLevel {
  PRIVATE
  CIRCLE
  GLOBAL

  @@map("share_level")
}

enum ModerationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED

  @@map("moderation_status")
}

enum ExtractionStatus {
  NONE
  PENDING
  DONE
  FAILED

  @@map("extraction_status")
}

enum ListType {
  WISHLIST
  GIFTLIST

  @@map("list_type")
}

enum ListAudience {
  MEMBERS
  CIRCLE
  EVENT
  CUSTOM

  @@map("list_audience")
}

enum ListRole {
  CREATOR
  OWNER
  CONTRIBUTOR
  READER

  @@map("list_role")
}

/// LST-03 : rôle minimal qui modifie les règles de visibilité.
enum VisibilityEditRole {
  CREATOR
  OWNER
  CONTRIBUTOR

  @@map("visibility_edit_role")
}

enum GiftExistence {
  HIDDEN
  REVEALED

  @@map("gift_existence")
}

enum GiftContent {
  NONE
  PARTIAL
  FULL

  @@map("gift_content")
}

enum VisibilityMode {
  ALL
  ONLY
  EXCEPT

  @@map("visibility_mode")
}

/// ART-12 : envie, j'adorerais, indispensable.
enum ItemPriority {
  WANT
  LOVE
  MUST

  @@map("item_priority")
}

/// LST-18 : l'état réel ; le reçu est porté par `received_at`.
enum ItemStatus {
  OPEN
  RESERVED
  PURCHASED
  WITHDRAWN

  @@map("item_status")
}

enum WithdrawnReason {
  ALREADY_HAVE
  NO_LONGER_WANTED

  @@map("withdrawn_reason")
}

/// ART-01 à ART-05. Propriétaire absent après la suppression de son profil : la fiche reste pour les
/// éléments qui la référencent (PRO-06).
model Product {
  id                  String           @id @db.Uuid
  ownerProfileId      String?          @map("owner_profile_id") @db.Uuid
  title               String           @db.VarChar(200)
  description         String           @default("") @db.VarChar(2000)
  /// EXT-47 : clé aléatoire de 128 bits, en hexadécimal.
  imageKey            String?          @map("image_key") @db.Char(32)
  /// EXT-46 : l'image vient d'une photo de l'utilisateur (jamais publiée au catalogue global, REP-04).
  imageFromPhoto      Boolean          @default(false) @map("image_from_photo")
  unitPriceMinor      BigInt?          @map("unit_price_minor")
  currency            String           @db.Char(3)
  merchant            String?          @db.VarChar(120)
  sourceUrl           String?          @map("source_url") @db.VarChar(2048)
  normalizedUrl       String?          @map("normalized_url") @db.VarChar(2048)
  source              ProductSource
  shareLevel          ShareLevel       @default(PRIVATE) @map("share_level")
  moderationStatus    ModerationStatus @default(NONE) @map("moderation_status")
  extractionStatus    ExtractionStatus @default(NONE) @map("extraction_status")
  extractionStartedAt DateTime?        @map("extraction_started_at") @db.Timestamptz(3)
  /// EXT-07 : champs de confiance basse.
  uncertainFields     String[]         @default([]) @map("uncertain_fields") @db.VarChar(32)
  extractionTruncated Boolean          @default(false) @map("extraction_truncated")
  priceCheckedAt      DateTime?        @map("price_checked_at") @db.Timestamptz(3)
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile?   @relation(fields: [ownerProfileId], references: [id], onDelete: SetNull)
  items ListItem[]

  @@index([ownerProfileId])
  @@index([normalizedUrl])
  @@index([shareLevel])
  @@map("product")
}

/// LST-01, GFT-03, LST-20. `creator_profile_id` absent après le retrait du créateur (LST-04).
model List {
  id                    String             @id @db.Uuid
  type                  ListType
  title                 String             @db.VarChar(120)
  description           String             @default("") @db.VarChar(1000)
  creatorProfileId      String?            @map("creator_profile_id") @db.Uuid
  /// WSH-06 : « Mes envies » de ce profil, une seule.
  personalProfileId     String?            @unique @map("personal_profile_id") @db.Uuid
  /// EVT-29 : événement de rattachement ; jamais sur une liste personnelle (`CHECK`).
  eventId               String?            @map("event_id") @db.Uuid
  audience              ListAudience
  defaultItemVisibility VisibilityMode     @default(ALL) @map("default_item_visibility")
  visibilityEditRole    VisibilityEditRole @default(CREATOR) @map("visibility_edit_role")
  giftExistence         GiftExistence      @default(HIDDEN) @map("gift_existence")
  giftContent           GiftContent        @default(NONE) @map("gift_content")
  archivedAt            DateTime?          @map("archived_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)
  version               Int                @default(1)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator       Profile?              @relation("ListCreator", fields: [creatorProfileId], references: [id], onDelete: SetNull)
  personal      Profile?              @relation("PersonalList", fields: [personalProfileId], references: [id], onDelete: SetNull)
  event         Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recipients    ListRecipient[]
  members       ListMember[]
  audienceOf    ListAudienceProfile[]
  items         ListItem[]
  notifications Notification[]

  @@index([creatorProfileId])
  @@index([eventId])
  @@index([deletedAt])
  @@map("list")
}

model ListRecipient {
  id        String   @id @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([listId, profileId])
  @@index([profileId])
  @@map("list_recipient")
}

/// LST-02 : un seul `CREATOR` par liste (index unique partiel) ; un destinataire de giftlist n'est
/// jamais membre (déclencheurs).
model ListMember {
  id        String   @id @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  role      ListRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([listId, profileId])
  @@index([profileId])
  @@map("list_member")
}

/// VIS-01 : sélection explicite (`audience = CUSTOM`).
model ListAudienceProfile {
  id        String   @id @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([listId, profileId])
  @@index([profileId])
  @@map("list_audience_profile")
}

/// ART-10 à ART-12, LST-10 à LST-19. Coût total = quantité × prix unitaire, jamais stocké.
model ListItem {
  id                  String           @id @db.Uuid
  listId              String           @map("list_id") @db.Uuid
  productId           String           @map("product_id") @db.Uuid
  addedByProfileId    String?          @map("added_by_profile_id") @db.Uuid
  intendedRecipientId String?          @map("intended_recipient_id") @db.Uuid
  quantity            Int              @default(1)
  unitPriceMinor      BigInt?          @map("unit_price_minor")
  currency            String           @db.Char(3)
  priority            ItemPriority     @default(WANT)
  note                String           @default("") @db.VarChar(500)
  manyWelcome         Boolean          @default(false) @map("many_welcome")
  position            Int
  visibilityMode      VisibilityMode   @default(ALL) @map("visibility_mode")
  status              ItemStatus       @default(OPEN)
  withdrawnReason     WithdrawnReason? @map("withdrawn_reason")
  isSuggestion        Boolean          @default(false) @map("is_suggestion")
  shownToRecipient    Boolean          @default(false) @map("shown_to_recipient")
  receivedAt          DateTime?        @map("received_at") @db.Timestamptz(3)
  /// EVT-27 : origine d'une reprise ; un élément ne se reprend qu'une fois.
  carriedFromItemId   String?          @unique @map("carried_from_item_id") @db.Uuid
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  list              List                    @relation(fields: [listId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  addedBy           Profile?                @relation("ItemAddedBy", fields: [addedByProfileId], references: [id], onDelete: SetNull)
  intendedRecipient Profile?                @relation("ItemIntendedFor", fields: [intendedRecipientId], references: [id], onDelete: SetNull)
  carriedFrom       ListItem?               @relation("ItemCarry", fields: [carriedFromItemId], references: [id], onDelete: SetNull)
  carriedTo         ListItem?               @relation("ItemCarry")
  ruleProfiles      ItemVisibilityProfile[]
  comments          Comment[]
  follows           ItemFollow[]
  notifications     Notification[]
  accounting        ItemAccounting?

  @@index([listId, position])
  @@index([productId])
  @@index([addedByProfileId])
  @@map("list_item")
}

model ItemVisibilityProfile {
  id        String   @id @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item    ListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([itemId, profileId])
  @@index([profileId])
  @@map("item_visibility_profile")
}

/// VIS-14. Ajout seul (DAT-02) ; sans clé étrangère, pour survivre à l'élément et au profil.
model VisibilityChangeLog {
  id        String   @id @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  itemId    String?  @map("item_id") @db.Uuid
  changedBy String   @map("changed_by") @db.Uuid
  before    Json
  after     Json
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([listId, at])
  @@map("visibility_change_log")
}

/// EXT-35 : données publiques de la page seulement.
model ExtractionCache {
  id            String   @id @db.Uuid
  normalizedUrl String   @unique @map("normalized_url") @db.VarChar(2048)
  result        Json
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("extraction_cache")
}

// --- Événements (docs/spec/05, docs/spec/12 « Événements » ; ADR 0017) ---

enum EventType {
  CHRISTMAS
  BIRTHDAY
  BIRTH
  WEDDING
  OTHER

  @@map("event_type")
}

/// EVT-02
enum EventMode {
  EXCHANGE
  HONOREE

  @@map("event_mode")
}

enum EventStatus {
  UPCOMING
  DONE
  CANCELLED

  @@map("event_status")
}

enum EventRole {
  ORGANIZER
  PARTICIPANT

  @@map("event_role")
}

/// EVT-13
enum Rsvp {
  PENDING
  YES
  MAYBE
  NO

  @@map("rsvp")
}

/// EVT-01, EVT-05, EVT-09. `mode` et `is_surprise` ne changent pas (déclencheur) ;
/// `is_surprise ⇒ mode = HONOREE` (`CHECK`).
model Event {
  id                   String      @id @db.Uuid
  title                String      @db.VarChar(120)
  /// Jour sans heure, lu dans `timezone` (EVT-05).
  date                 DateTime    @db.Date
  timezone             String      @db.VarChar(64)
  place                String      @default("") @db.VarChar(200)
  description          String      @default("") @db.VarChar(2000)
  type                 EventType
  mode                 EventMode
  isSurprise           Boolean     @default(false) @map("is_surprise")
  suggestedBudgetMinor BigInt?     @map("suggested_budget_minor")
  currency             String      @db.Char(3)
  status               EventStatus @default(UPCOMING)
  createdBy            String?     @map("created_by") @db.Uuid
  /// EVT-40 : événement d'origine d'une recréation ; sans clé étrangère.
  recreatedFromId      String?     @map("recreated_from_id") @db.Uuid
  cancelledAt          DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  /// EVT-13, EVT-32 : rappels et invitation du lendemain, envoyés une seule fois (phase 4).
  reminder14At         DateTime?   @map("reminder_14_at") @db.Timestamptz(3)
  reminder3At          DateTime?   @map("reminder_3_at") @db.Timestamptz(3)
  dayAfterAt           DateTime?   @map("day_after_at") @db.Timestamptz(3)
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator       Profile?                 @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants  EventParticipant[]
  surpriseFor   EventSurpriseRecipient[]
  lists         List[]
  notifications Notification[]
  budgets       Budget[]

  @@index([status, date])
  @@map("event")
}

/// EVT-06 à EVT-08, EVT-13. Un honoré de surprise n'a jamais de ligne ici (déclencheurs croisés).
model EventParticipant {
  id          String    @id @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  role        EventRole @default(PARTICIPANT)
  /// EVT-07 : seulement en `HONOREE` sans surprise (déclencheur).
  isHonoree   Boolean   @default(false) @map("is_honoree")
  rsvp        Rsvp      @default(PENDING)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(3)
  invitedBy   String?   @map("invited_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile  @relation("EventParticipantProfile", fields: [profileId], references: [id], onDelete: Cascade)
  inviter Profile? @relation("EventParticipantInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([eventId, profileId])
  @@index([profileId])
  @@map("event_participant")
}

/// EVT-07 : honorés d'une surprise, lus par les seuls chemins d'offreur (ADR 0017).
model EventSurpriseRecipient {
  id        String   @id @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([eventId, profileId])
  @@index([profileId])
  @@map("event_surprise_recipient")
}

// --- Échanges (docs/spec/06, docs/spec/12 « Échanges » ; ADR 0018, phase 4) ---

enum CommentThread {
  PUBLIC
  GIVERS

  @@map("comment_thread")
}

enum CommentKind {
  MESSAGE
  ACTIVITY

  @@map("comment_kind")
}

/// COM-16 : liste fermée.
enum CommentReactionKind {
  THUMBS_UP
  HEART
  LAUGH
  WOW
  PARTY
  THANKS

  @@map("comment_reaction_kind")
}

/// COM-01, COM-13 à COM-15. Une activité n'a ni texte ni mention ; un message supprimé non plus (`CHECK`).
model Comment {
  id              String        @id @db.Uuid
  itemId          String        @map("item_id") @db.Uuid
  thread          CommentThread
  kind            CommentKind
  authorProfileId String?       @map("author_profile_id") @db.Uuid
  body            String        @default("") @db.VarChar(2000)
  mentionIds      String[]      @default([]) @map("mention_ids") @db.Uuid
  /// COM-14 : code d'activité (`PRICE_CHANGED`…) et valeurs sans texte libre.
  activityCode    String?       @map("activity_code") @db.VarChar(32)
  activityData    Json?         @map("activity_data")
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  item          ListItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author        Profile?          @relation("CommentAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  reactions     CommentReaction[]
  notifications Notification[]

  @@index([itemId, thread, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorProfileId])
  @@map("comment")
}

model CommentReaction {
  commentId String              @map("comment_id") @db.Uuid
  profileId String              @map("profile_id") @db.Uuid
  reaction  CommentReactionKind
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([commentId, profileId, reaction])
  @@index([profileId])
  @@map("comment_reaction")
}

/// NOT-13 : `following` faux = désabonnement explicite, que le suivi d'office ne renverse pas.
model ItemFollow {
  itemId    String   @map("item_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  following Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item    ListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([itemId, profileId])
  @@index([profileId])
  @@map("item_follow")
}

/// NOT-12
enum NotificationCategory {
  INVITATIONS
  LINKS
  COMMENTS
  MENTIONS
  GIFTS
  ITEMS
  EVENTS
  EXTRACTION
  SECURITY

  @@map("notification_category")
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL

  @@map("notification_channel")
}

/// NOT-17
enum DigestFrequency {
  DAILY
  WEEKLY
  OFF

  @@map("digest_frequency")
}

/// NOT-10, NOT-11 : identifiants seulement, aucun contenu ; revérifiée à chaque lecture.
model Notification {
  id             String               @id @db.Uuid
  profileId      String               @map("profile_id") @db.Uuid
  seq            BigInt
  category       NotificationCategory
  type           String               @db.VarChar(48)
  itemId         String?              @map("item_id") @db.Uuid
  thread         CommentThread?
  listId         String?              @map("list_id") @db.Uuid
  eventId        String?              @map("event_id") @db.Uuid
  commentId      String?              @map("comment_id") @db.Uuid
  actorProfileId String?              @map("actor_profile_id") @db.Uuid
  data           Json                 @default("{}")
  readAt         DateTime?            @map("read_at") @db.Timestamptz(3)
  /// NOT-14 : échéance de la push (fin des heures calmes) ; absente si aucune push n'est due.
  pushDueAt      DateTime?            @map("push_due_at") @db.Timestamptz(3)
  pushSentAt     DateTime?            @map("push_sent_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile   @relation("NotificationProfile", fields: [profileId], references: [id], onDelete: Cascade)
  actor   Profile?  @relation("NotificationActor", fields: [actorProfileId], references: [id], onDelete: SetNull)
  item    ListItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  list    List?     @relation(fields: [listId], references: [id], onDelete: Cascade)
  event   Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  comment Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([profileId, seq])
  @@index([profileId, createdAt])
  @@index([pushDueAt])
  @@index([createdAt])
  @@map("notification")
}

/// RT-12 : `seq` croissant par profil.
model NotificationCounter {
  profileId String @id @map("profile_id") @db.Uuid
  lastSeq   BigInt @default(0) @map("last_seq")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_counter")
}

/// NOT-04 : écarts au défaut de NOT-12 ; `SECURITY` jamais désactivé (`CHECK`).
model NotificationPref {
  profileId String               @map("profile_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, category, channel])
  @@map("notification_pref")
}

/// NOT-14, NOT-17, RT-11. Heures en minutes depuis minuit, heure locale du profil.
model NotificationSettings {
  profileId     String          @id @map("profile_id") @db.Uuid
  quietEnabled  Boolean         @default(true) @map("quiet_enabled")
  quietStart    Int             @default(1260) @map("quiet_start") @db.SmallInt
  quietEnd      Int             @default(480) @map("quiet_end") @db.SmallInt
  digest        DigestFrequency @default(DAILY)
  sharePresence Boolean         @default(true) @map("share_presence")
  lastDigestAt  DateTime?       @map("last_digest_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// NOT-15, NOT-16 : un appareil, rattaché à la session qui l'a créé.
model PushSubscription {
  id        String   @id @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(1024)
  p256dh    String   @db.VarChar(128)
  auth      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  Session                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profiles PushSubscriptionProfile[]

  @@index([sessionId])
  @@map("push_subscription")
}

model PushSubscriptionProfile {
  subscriptionId String   @map("subscription_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  showDetails    Boolean  @default(false) @map("show_details")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  profile      Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, profileId])
  @@index([profileId])
  @@map("push_subscription_profile")
}

// ---------------------------------------------------------------------------
// Compta (07, ADR 0019)
// ---------------------------------------------------------------------------

/// CPT-01, CPT-53 à CPT-55
enum ContributionMode {
  FULL
  PERCENT
  FIXED

  @@map("contribution_mode")
}

/// CPT-20 à CPT-22, CPT-65
enum SettlementState {
  NONE
  DUE
  CLAIMED
  SETTLED

  @@map("settlement_state")
}

/// CPT-58
enum AccountingReviewKind {
  COST
  OPTIONS

  @@map("accounting_review_kind")
}

enum AccountingReviewStatus {
  PENDING
  APPROVED
  REFUSED
  REPLACED
  CLOSED

  @@map("accounting_review_status")
}

/// CPT-61
enum BuyerRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED

  @@map("buyer_request_status")
}

/// CPT-68
enum OffsetProposalStatus {
  PENDING
  CONFIRMED
  DECLINED
  STALE

  @@map("offset_proposal_status")
}

/// Fiche de compta d'un élément (ADR 0019), créée à la première participation. Détachée par le
/// déclencheur `item_accounting_detach` quand l'élément disparaît (CPT-73) : `item_id` vidé,
/// titre et événement relevés. `detached_event_id` sans clé étrangère : il survit à l'événement.
model ItemAccounting {
  id                   String    @id @db.Uuid
  itemId               String?   @unique @map("item_id") @db.Uuid
  currency             String    @db.Char(3)
  /// CPT-57 : coût prévu ; absent sur un élément sans prix (CPT-55).
  plannedTotalMinor    BigInt?   @map("planned_total_minor")
  buyerProfileId       String?   @map("buyer_profile_id") @db.Uuid
  reviewEnabled        Boolean   @default(true) @map("review_enabled")
  receiptEnabled       Boolean   @default(false) @map("receipt_enabled")
  /// CPT-53 : rang d'arrivée suivant.
  nextRank             Int       @default(1) @map("next_rank")
  detachedTitle        String?   @map("detached_title") @db.VarChar(300)
  detachedEventId      String?   @map("detached_event_id") @db.Uuid
  /// CPT-52, CPT-73 : destinataires et honorés relevés au détachement ; jamais d'accès.
  detachedRecipientIds String[]  @default([]) @map("detached_recipient_ids") @db.Uuid
  detachedAt           DateTime? @map("detached_at") @db.Timestamptz(3)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  item          ListItem?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
  buyer         Profile?           @relation("AccountingBuyer", fields: [buyerProfileId], references: [id], onDelete: SetNull)
  contributions Contribution[]
  purchase      Purchase?
  reviews       AccountingReview[]
  buyerRequests BuyerRequest[]
  shortfalls    ShortfallNotice[]
  ledger        LedgerEntry[]

  @@index([buyerProfileId])
  @@index([detachedEventId])
  @@map("item_accounting")
}

/// CPT-01 à CPT-07, CPT-53 à CPT-56, CPT-65. Somme des montants ≤ coût prévu : verrou sur la fiche.
model Contribution {
  id               String           @id @db.Uuid
  accountingId     String           @map("accounting_id") @db.Uuid
  /// DAT-06 : vidé à la suppression du profil.
  profileId        String?          @map("profile_id") @db.Uuid
  mode             ContributionMode
  shareNum         Int?             @map("share_num")
  shareDen         Int?             @map("share_den")
  units            Int?
  /// Absent seulement en `FULL` sans prix (CPT-55).
  amountMinor      BigInt?          @map("amount_minor")
  /// CPT-18 : part d'avant l'achat, plancher d'un refus de hausse.
  prePurchaseMinor BigInt?          @map("pre_purchase_minor")
  rank             Int
  settledMinor     BigInt           @default(0) @map("settled_minor")
  settlement       SettlementState  @default(NONE)
  settledAt        DateTime?        @map("settled_at") @db.Timestamptz(3)
  settlementNote   String?          @map("settlement_note") @db.VarChar(60)
  remindedSevenAt  DateTime?        @map("reminded_7_at") @db.Timestamptz(3)
  remindedEventAt  DateTime?        @map("reminded_event_at") @db.Timestamptz(3)
  nudgedAt         DateTime?        @map("nudged_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)
  profile    Profile?       @relation("ContributionProfile", fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([accountingId, profileId])
  @@unique([accountingId, rank])
  @@index([profileId, settlement])
  @@map("contribution")
}

/// CPT-12 à CPT-15, CPT-18 ; supprimé quand l'achat est décoché (le journal le garde).
model Purchase {
  id                String   @id @db.Uuid
  accountingId      String   @unique @map("accounting_id") @db.Uuid
  buyerProfileId    String?  @map("buyer_profile_id") @db.Uuid
  purchasedAt       DateTime @map("purchased_at") @db.Timestamptz(3)
  plannedTotalMinor BigInt?  @map("planned_total_minor")
  actualTotalMinor  BigInt?  @map("actual_total_minor")
  receiptKey        String?  @map("receipt_key") @db.VarChar(64)
  /// CPT-18 : fin de la fenêtre de refus d'une hausse.
  raiseUntil        DateTime @map("raise_until") @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)
  buyer      Profile?       @relation("PurchaseBuyer", fields: [buyerProfileId], references: [id], onDelete: SetNull)

  @@index([buyerProfileId])
  @@map("purchase")
}

/// CPT-57, CPT-58 : une demande `PENDING` par fiche et par genre (index unique partiel).
model AccountingReview {
  id              String                 @id @db.Uuid
  accountingId    String                 @map("accounting_id") @db.Uuid
  kind            AccountingReviewKind
  authorProfileId String?                @map("author_profile_id") @db.Uuid
  proposed        Json
  status          AccountingReviewStatus @default(PENDING)
  decidedBy       String?                @map("decided_by") @db.Uuid
  decidedAt       DateTime?              @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)
  author     Profile?       @relation("ReviewAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  decider    Profile?       @relation("ReviewDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([accountingId])
  @@map("accounting_review")
}

/// CPT-61 : une demande `PENDING` par fiche (index unique partiel).
model BuyerRequest {
  id                 String             @id @db.Uuid
  accountingId       String             @map("accounting_id") @db.Uuid
  candidateProfileId String             @map("candidate_profile_id") @db.Uuid
  status             BuyerRequestStatus @default(PENDING)
  decidedBy          String?            @map("decided_by") @db.Uuid
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)
  candidate  Profile        @relation("BuyerCandidate", fields: [candidateProfileId], references: [id], onDelete: Cascade)
  decider    Profile?       @relation("BuyerRequestDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([accountingId])
  @@map("buyer_request")
}

/// CPT-19 : lisible par son seul auteur.
model ShortfallNotice {
  id                 String   @id @db.Uuid
  accountingId       String   @map("accounting_id") @db.Uuid
  authorProfileId    String   @map("author_profile_id") @db.Uuid
  amountMinor        BigInt   @map("amount_minor")
  notifiedProfileIds String[] @map("notified_profile_ids") @db.Uuid
  at                 DateTime @default(now()) @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)
  author     Profile        @relation("ShortfallAuthor", fields: [authorProfileId], references: [id], onDelete: Cascade)

  @@index([accountingId])
  @@map("shortfall_notice")
}

/// CPT-68 : une proposition `PENDING` par paire et par devise (index unique partiel).
model OffsetProposal {
  id                   String               @id @db.Uuid
  proposerProfileId    String               @map("proposer_profile_id") @db.Uuid
  counterpartProfileId String               @map("counterpart_profile_id") @db.Uuid
  currency             String               @db.Char(3)
  snapshot             Json
  status               OffsetProposalStatus @default(PENDING)
  decidedAt            DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  proposer    Profile @relation("OffsetProposer", fields: [proposerProfileId], references: [id], onDelete: Cascade)
  counterpart Profile @relation("OffsetCounterpart", fields: [counterpartProfileId], references: [id], onDelete: Cascade)

  @@index([proposerProfileId])
  @@index([counterpartProfileId])
  @@map("offset_proposal")
}

/// CPT-50, CPT-70, DAT-02 : ajout seul (`REVOKE UPDATE, DELETE`). `actor_profile_id` et
/// `target_id` sans clé étrangère : une écriture survit à tout (comme `security_log`).
model LedgerEntry {
  id             String   @id @db.Uuid
  accountingId   String   @map("accounting_id") @db.Uuid
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  kind           String   @db.VarChar(40)
  targetId       String?  @map("target_id") @db.Uuid
  before         Json?
  after          Json?
  operationId    String   @map("operation_id") @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(3)

  accounting ItemAccounting @relation(fields: [accountingId], references: [id], onDelete: Restrict)

  @@index([accountingId, at])
  @@index([operationId])
  @@map("ledger_entry")
}

/// CPT-40, CPT-69 : privé à son profil.
model Budget {
  id                 String   @id @db.Uuid
  profileId          String   @map("profile_id") @db.Uuid
  eventId            String   @map("event_id") @db.Uuid
  recipientProfileId String?  @map("recipient_profile_id") @db.Uuid
  amountMinor        BigInt   @map("amount_minor")
  currency           String   @db.Char(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile   Profile  @relation("BudgetOwner", fields: [profileId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient Profile? @relation("BudgetRecipient", fields: [recipientProfileId], references: [id], onDelete: Cascade)

  /// CPT-69 : `NULLS NOT DISTINCT` ajouté à la main dans la migration (un budget global par événement).
  @@unique([profileId, eventId, recipientProfileId], map: "budget_scope_key")
  @@index([profileId])
  @@map("budget")
}

/// API-16, CPT-71 : clé par profil, 30 jours.
model IdempotencyRecord {
  id          String   @id @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  key         String   @db.VarChar(128)
  requestHash String   @map("request_hash") @db.Char(64)
  status      Int      @db.SmallInt
  response    Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}
