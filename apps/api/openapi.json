{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/email": {
      "put": {
        "operationId": "requestEmailChange",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande reçue ; la suite arrive par e-mail."
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-16, AUTH-14 : même réponse que la nouvelle adresse soit libre ou prise.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/email/cancel": {
      "post": {
        "operationId": "cancelEmailChange",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-16 : annulation depuis l'ancienne adresse ; toutes les sessions sont révoquées.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/email/verify": {
      "post": {
        "operationId": "verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Lien de vérification (AUTH-15) ou de confirmation d'un changement d'adresse (AUTH-16). N'ouvre\njamais de session : on se connecte ensuite avec son mot de passe.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Connexion (AUTH-07) : nouvelle session, ancienne session du navigateur révoquée.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "signOut",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Déconnexion : session courante révoquée, cookies retirés.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "put": {
        "operationId": "changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-05, AUTH-14 : toutes les autres sessions tombent ; celle-ci est remplacée.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "operationId": "requestPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande reçue ; la suite arrive par e-mail."
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-06 : même réponse que l'adresse ait un compte ou non.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password/reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-06 : toutes les sessions, pré-authentifications et appareils de confiance révoqués.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/reauth": {
      "post": {
        "operationId": "reauthenticate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReauthDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-14 : même session, nouveau jeton, `reauth_at` posé ; jeton CSRF renouvelé.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande reçue ; la suite arrive par e-mail."
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "AUTH-01, AUTH-09 : même réponse (`202`), même délai, que l'adresse ait déjà un compte ou non.\nAucune session n'est ouverte ; le lien de vérification part par e-mail.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/example-items": {
      "post": {
        "operationId": "createExampleItem",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExampleItemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleItemRecipientView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "example-items"
        ]
      }
    },
    "/api/v1/example-items/{id}": {
      "get": {
        "operationId": "getExampleItem",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ExampleItemRecipientView"
                    },
                    {
                      "$ref": "#/components/schemas/ExampleItemGiverView"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "view",
                    "mapping": {
                      "recipient": "#/components/schemas/ExampleItemRecipientView",
                      "giver": "#/components/schemas/ExampleItemGiverView"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Vue polymorphe : la forme dépend du lecteur, discriminée par `view` (API-12).",
        "tags": [
          "example-items"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "État de la session et jeton CSRF (API-21, ADR 0013). Public : avant session, il pose la\npré-session (CSRF de connexion). Ne prolonge jamais le déverrouillage du profil.",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSessionListView"
                }
              }
            }
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "operationId": "revokeSession",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Erreur (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "`404` pour une session inconnue comme pour celle d'un autre compte (SEC-04).",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "info": {
    "title": "La Hotte API",
    "description": "Contrat de l’API La Hotte. Généré depuis les DTO NestJS, ne pas éditer.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "AccountSessionListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSessionView"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountSessionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userAgent": {
            "type": "string",
            "description": "Agent utilisateur déclaré par l'appareil, tel quel (512 caractères au plus).",
            "maxLength": 512
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "description": "Dernière activité, à 5 minutes près (ADR 0013).",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Session de la requête."
          }
        },
        "required": [
          "id",
          "userAgent",
          "createdAt",
          "lastSeenAt",
          "current"
        ]
      },
      "CreateExampleItemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Titre affiché du souhait.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Vélo de route"
          },
          "priority": {
            "default": "normal",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          }
        },
        "required": [
          "title"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmailTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "token"
        ]
      },
      "ExampleItemGiverView": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "giver"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          },
          "reservation": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExampleReservationView"
              }
            ]
          }
        },
        "required": [
          "view",
          "id",
          "title",
          "priority",
          "reservation"
        ]
      },
      "ExampleItemRecipientView": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "recipient"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          }
        },
        "required": [
          "view",
          "id",
          "title",
          "priority"
        ]
      },
      "ExamplePriority": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high"
        ]
      },
      "ExampleReservationView": {
        "type": "object",
        "properties": {
          "byName": {
            "type": "string",
            "maxLength": 80
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "byName",
          "at"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Chemin du champ, en notation pointée (`items.0.title`).",
            "example": "title"
          },
          "code": {
            "type": "string",
            "description": "Code stable de la contrainte non respectée.",
            "example": "isLength"
          },
          "message": {
            "type": "string",
            "example": "title doit contenir entre 1 et 120 caractères"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "NewPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          },
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Requête invalide"
          },
          "status": {
            "type": "number",
            "example": 400,
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "description": "Code stable, exploitable par le client.",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Identifiant de la requête, à citer pour un signalement."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "ReauthDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "AUTH-02 : 12 caractères au moins, sans règle de composition.",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          },
          "displayName": {
            "type": "string",
            "description": "Nom affiché du premier profil (PRO-01, PRO-02).",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "ageAttested": {
            "type": "boolean",
            "description": "AUTH-08 : case « J'ai 15 ans ou plus », non précochée. Seule la valeur `true` est acceptée.",
            "enum": [
              true
            ]
          },
          "locale": {
            "type": "string",
            "description": "Langue du navigateur ; à défaut, français.",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "example": "fr"
          },
          "timezone": {
            "type": "string",
            "description": "Fuseau IANA du navigateur ; à défaut, Europe/Paris.",
            "maxLength": 64,
            "example": "Europe/Paris"
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "ageAttested"
        ]
      },
      "SessionStatusView": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête X-CSRF-Token de chaque mutation."
          },
          "session": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionSummaryView"
              }
            ]
          }
        },
        "required": [
          "authenticated",
          "csrfToken",
          "session"
        ]
      },
      "SessionSummaryView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activeProfileId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "profileUnlocked": {
            "type": "boolean",
            "description": "Profil actif présent et déverrouillé (PIN-02)."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "activeProfileId",
          "profileUnlocked",
          "expiresAt"
        ]
      }
    }
  }
}
