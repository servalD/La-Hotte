  "info": {
    "title": "La Hotte API",
    "description": "Contrat de l’API La Hotte. Généré depuis les DTO NestJS, ne pas éditer.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "AccountSessionListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSessionView"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountSessionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userAgent": {
            "type": "string",
            "description": "Agent utilisateur déclaré par l'appareil, tel quel (512 caractères au plus).",
            "maxLength": 512
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "description": "Dernière activité, à 5 minutes près (ADR 0013).",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Session de la requête."
          }
        },
        "required": [
          "id",
          "userAgent",
          "createdAt",
          "lastSeenAt",
          "current"
        ]
      },
      "AccountView": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "hasPassword": {
            "type": "boolean"
          },
          "googleLinked": {
            "type": "boolean",
            "description": "AUTH-03 : un compte Google est associé ; la ré-authentification peut passer par lui."
          },
          "totpEnabled": {
            "type": "boolean",
            "description": "La ré-authentification demande alors un code (AUTH-14)."
          },
          "recoveryCodesRemaining": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "email",
          "emailVerified",
          "hasPassword",
          "googleLinked",
          "totpEnabled",
          "recoveryCodesRemaining"
        ]
      },
      "CreateExampleItemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Titre affiché du souhait.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Vélo de route"
          },
          "priority": {
            "default": "normal",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          }
        },
        "required": [
          "title"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmailTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "token"
        ]
      },
      "ExampleItemGiverView": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "giver"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          },
          "reservation": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExampleReservationView"
              }
            ]
          }
        },
        "required": [
          "view",
          "id",
          "title",
          "priority",
          "reservation"
        ]
      },
      "ExampleItemRecipientView": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "recipient"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExamplePriority"
              }
            ]
          }
        },
        "required": [
          "view",
          "id",
          "title",
          "priority"
        ]
      },
      "ExamplePriority": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high"
        ]
      },
      "ExampleReservationView": {
        "type": "object",
        "properties": {
          "byName": {
            "type": "string",
            "maxLength": 80
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "byName",
          "at"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Chemin du champ, en notation pointée (`items.0.title`).",
            "example": "title"
          },
          "code": {
            "type": "string",
            "description": "Code stable de la contrainte non respectée.",
            "example": "isLength"
          },
          "message": {
            "type": "string",
            "example": "title doit contenir entre 1 et 120 caractères"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "GoogleRedirectView": {
        "type": "object",
        "properties": {
          "authorizationUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "authorizationUrl"
        ]
      },
      "GoogleRegistrationDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Nom affiché du premier profil (PRO-01, PRO-02).",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "ageAttested": {
            "type": "boolean",
            "description": "AUTH-08 : case « J'ai 15 ans ou plus », non précochée. Seule la valeur `true` est acceptée.",
            "enum": [
              true
            ]
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "example": "fr"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "example": "Europe/Paris"
          }
        },
        "required": [
          "displayName",
          "ageAttested"
        ]
      },
      "GoogleStartDto": {
        "type": "object",
        "properties": {
          "registration": {
            "$ref": "#/components/schemas/GoogleRegistrationDto"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "NewPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "PasswordResetConfirmDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          },
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Requête invalide"
          },
          "status": {
            "type": "number",
            "example": 400,
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "description": "Code stable, exploitable par le client.",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Identifiant de la requête, à citer pour un signalement."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "ReauthDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Absent seulement après un retour de Google qui attend le code TOTP\n(`reauth_second_factor`, AUTH-14).",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          },
          "code": {
            "type": "string",
            "description": "AUTH-14 : exigé si le TOTP est actif (code TOTP ou de secours).",
            "pattern": "^[0-9A-Za-z -]{6,32}$",
            "minLength": 6,
            "maxLength": 32
          }
        }
      },
      "RecoveryCodesView": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "minItems": 10,
            "maxItems": 10,
            "example": [
              "7K2M-9QXA-4T0P-ZR8H"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recoveryCodes"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "AUTH-02 : 12 caractères au moins, sans règle de composition.",
            "minLength": 12,
            "maxLength": 256,
            "format": "password"
          },
          "displayName": {
            "type": "string",
            "description": "Nom affiché du premier profil (PRO-01, PRO-02).",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "ageAttested": {
            "type": "boolean",
            "description": "AUTH-08 : case « J'ai 15 ans ou plus », non précochée. Seule la valeur `true` est acceptée.",
            "enum": [
              true
            ]
          },
          "locale": {
            "type": "string",
            "description": "Langue du navigateur ; à défaut, français.",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "example": "fr"
          },
          "timezone": {
            "type": "string",
            "description": "Fuseau IANA du navigateur ; à défaut, Europe/Paris.",
            "maxLength": 64,
            "example": "Europe/Paris"
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "ageAttested"
        ]
      },
      "SecondFactorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9A-Za-z -]{6,32}$",
            "minLength": 6,
            "maxLength": 32
          },
          "trustDevice": {
            "type": "boolean",
            "description": "« Faire confiance à cet appareil 30 jours » (AUTH-12).",
            "default": false
          }
        },
        "required": [
          "code"
        ]
      },
      "SessionStatusView": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête X-CSRF-Token de chaque mutation."
          },
          "session": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionSummaryView"
              }
            ]
          },
          "secondFactorPending": {
            "type": "boolean",
            "description": "Mot de passe validé, second facteur attendu (AUTH-12) : le client affiche la saisie du code\n(`POST /auth/totp/verify`). Expire en 5 minutes."
          }
        },
        "required": [
          "authenticated",
          "csrfToken",
          "session",
          "secondFactorPending"
        ]
      },
      "SessionSummaryView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activeProfileId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "profileUnlocked": {
            "type": "boolean",
            "description": "Profil actif présent et déverrouillé (PIN-02)."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "activeProfileId",
          "profileUnlocked",
          "expiresAt"
        ]
      },
      "TotpActivationView": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête X-CSRF-Token de chaque mutation."
          },
          "session": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionSummaryView"
              }
            ]
          },
          "secondFactorPending": {
            "type": "boolean",
            "description": "Mot de passe validé, second facteur attendu (AUTH-12) : le client affiche la saisie du code\n(`POST /auth/totp/verify`). Expire en 5 minutes."
          },
          "recoveryCodes": {
            "minItems": 10,
            "maxItems": 10,
            "example": [
              "7K2M-9QXA-4T0P-ZR8H"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "authenticated",
          "csrfToken",
          "session",
          "secondFactorPending",
          "recoveryCodes"
        ]
      },
      "TotpCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": [
          "code"
        ]
      },
      "TotpEnrollmentView": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Secret base32, pour une saisie à la main."
          },
          "otpauthUri": {
            "type": "string",
            "description": "URI otpauth:// à afficher en QR code."
          }
        },
        "required": [
          "secret",
          "otpauthUri"
        ]
      },
      "TrustedDeviceListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrustedDeviceView"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "TrustedDeviceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userAgent": {
            "type": "string",
            "maxLength": 512
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Appareil de ce navigateur."
          }
        },
        "required": [
          "id",
          "userAgent",
          "createdAt",
          "expiresAt",
          "current"
        ]
      }
    }
  }
}
